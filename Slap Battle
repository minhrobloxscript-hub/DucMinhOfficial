-- ===== KÉO THẢ FIX (giữ được nút) =====
local dragging = false
local dragStart = nil
local startPos = nil
local dragTouch = nil
local moved = false

auraBtn.Active = true

auraBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch 
    or input.UserInputType == Enum.UserInputType.MouseButton1 then
        
        dragTouch = input
        dragStart = input.Position
        startPos = auraBtn.Position
        moved = false
        
        task.delay(0.15, function()
            if dragTouch == input then
                dragging = true
            end
        end)
    end
end)

UIS.InputChanged:Connect(function(input)
    if dragging and input == dragTouch then
        local delta = input.Position - dragStart
        
        if math.abs(delta.X) > 5 or math.abs(delta.Y) > 5 then
            moved = true
        end
        
        auraBtn.Position = UDim2.new(
            startPos.X.Scale,
            startPos.X.Offset + delta.X,
            startPos.Y.Scale,
            startPos.Y.Offset + delta.Y
        )
    end
end)

UIS.InputEnded:Connect(function(input)
    if input == dragTouch then
        dragging = false
        dragTouch = nil
    end
end)

-- ===== MAIN AURA LOOP =====
RunService.Heartbeat:Connect(function()
    if not getgenv().auraEnabled then return end
    
    pcall(function()
        local remote = getGloveHitRemote()
        if not remote then return end
        
        local char = player.Character
        if not char then return end
        
        local rootPart = char:FindFirstChild('HumanoidRootPart') or char:FindFirstChildWhichIsA('BasePart')
        if not rootPart then return end
        
        -- Kiểm tra xem có trong arena không
        if not char:FindFirstChild("entered") then return end
        
        for _, plr in pairs(Players:GetPlayers()) do
            if plr ~= player then
                local targetChar = plr.Character
                if targetChar then
                    -- Kiểm tra các điều kiện
                    if not targetChar:FindFirstChild("entered") then continue end
                    if targetChar:FindFirstChild("rock") then continue end
                    if targetChar:FindFirstChild("Head") and targetChar.Head:FindFirstChild("UnoReverseCard") then continue end
                    
                    local targetPart = targetChar:FindFirstChild('HumanoidRootPart') or targetChar:FindFirstChildWhichIsA('BasePart')
                    if targetPart then
                        local distance = (rootPart.Position - targetPart.Position).Magnitude
                        if distance <= maxDistance then
                            -- Thử slapping với các phần cơ thể
                            local parts = {"Head", "Torso", "HumanoidRootPart"}
                            for _, partName in ipairs(parts) do
                                local part = targetChar:FindFirstChild(partName)
                                if part then
                                    remote:FireServer(part)
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
    end)
end)

