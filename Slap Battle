-- Hàm lấy remote cho glove hiện tại
local function getGloveHitRemote()
    local glove = player.leaderstats and player.leaderstats:FindFirstChild("Glove")
    if not glove then return nil end
    
    local gloveName = glove.Value
    local remote = gloveHits[gloveName]
    
    if remote then return remote end
    
    -- Nếu không tìm thấy trong gloveHits, thử tìm trực tiếp
    local possibleNames = {
        gloveName .. "Hit",
        gloveName .. "Ability",
        gloveName .. "Slap",
        "GeneralHit",
        "SlapHit"
    }
    for _, name in ipairs(possibleNames) do
        local r = ReplicatedStorage:FindFirstChild(name)
        if r then
            gloveHits[gloveName] = r
            return r
        end
    end
    
    return nil
end

